# Generate real random local secrets with scripts/init-env.sh.
DATABASE_URL=jdbc:postgresql://localhost:5432/done
DATABASE_USER=done
DATABASE_PASSWORD=
JWT_SECRET=
JWT_ISSUER=done-api
DB_PORT=5432
PORT=8080
APPLE_ENABLED=false
APPLE_CLIENT_ID=ro.done.app
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=secrets/AuthKey.p8
APPLE_ENCRYPTION_KEY=
# Mock public pages for local review. Prod refuses these values.
PUBLIC_SITE_MOCK=true
PUBLIC_ORIGIN=http://127.0.0.1:8080
OPERATOR_NAME="DONE Demo Operator"
OPERATOR_ADDRESS="Demo address - replace before publication"
SUPPORT_EMAIL=support@done.example
PRIVACY_EMAIL=privacy@done.example
HOSTING_REGION="Demo environment - not publicly hosted"
DATA_PROCESSORS="Demo hosting provider - replace before publication"
BACKUP_RETENTION_DAYS=30
ALLOW_ANONYMOUS_SHARING=true
APPLE_WEB_CLIENT_ID=
APPLE_WEB_REDIRECT_URI=
