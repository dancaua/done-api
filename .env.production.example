# Copy to .env.production, chmod 600, fill real values. Never commit secrets.
PUBLIC_DOMAIN=REPLACE_DOMAIN
PUBLIC_ORIGIN=https://REPLACE_DOMAIN
PUBLIC_SITE_MOCK=false
OPERATOR_NAME=REPLACE_OPERATOR
OPERATOR_ADDRESS=REPLACE_ADDRESS
SUPPORT_EMAIL=REPLACE_SUPPORT_EMAIL
PRIVACY_EMAIL=REPLACE_PRIVACY_EMAIL
HOSTING_REGION=REPLACE_HOSTING_REGION
DATA_PROCESSORS=REPLACE_ACTUAL_PROCESSORS
BACKUP_RETENTION_DAYS=30
MYSQL_ROOT_PASSWORD=
DATABASE_PASSWORD=
JWT_SECRET=
JWT_ISSUER=done-api
APPLE_ENABLED=false
APPLE_CLIENT_ID=ro.done.app
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_ENCRYPTION_KEY=
# Optional Services ID grouped with the native App ID, for web account deletion.
APPLE_WEB_CLIENT_ID=
APPLE_WEB_REDIRECT_URI=
# Native local projection publisher is a separate opt-in. Canonical account shares work without it.
ALLOW_ANONYMOUS_SHARING=false

# Runtime SQL principal is separate from the Flyway/schema owner; use different random passwords.
RUNTIME_DATABASE_PASSWORD=
# SMTP provider must verify this sender/domain; configure SPF, DKIM and DMARC with the provider.
RECOVERY_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_SSL=false
