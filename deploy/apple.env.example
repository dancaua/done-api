# PLACEHOLDERS ONLY. Keep disabled until all real Apple values are configured.
APPLE_ENABLED=false
APPLE_CLIENT_ID=ro.done.app
APPLE_TEAM_ID=REPLACE_WITH_APPLE_TEAM_ID
APPLE_KEY_ID=REPLACE_WITH_APPLE_KEY_ID
APPLE_PRIVATE_KEY_PATH=/run/secrets/apple-signin.p8
APPLE_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_RANDOM_BYTES
# Optional web account-deletion flow, separate Services ID registered with Apple.
APPLE_WEB_CLIENT_ID=
APPLE_WEB_REDIRECT_URI=
