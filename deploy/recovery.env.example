# DigitalOcean runtime configuration for the provided Microsoft 365 mailbox.
# Keep disabled until authentication and delivery have been verified.
SUPPORT_EMAIL=support@subkeeper.com
RECOVERY_ENABLED=false
RECOVERY_DELIVERY_ENABLED=true
PUBLIC_ORIGIN=https://done-appliance-f9pbg.ondigitalocean.app
RECOVERY_FROM=support@subkeeper.com
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USERNAME=support@subkeeper.com
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_SSL=false
# Store the SMTP credential as an encrypted RUN_TIME secret; never commit it.
# After provider authentication and cloud delivery verification, enable recovery and redeploy.
